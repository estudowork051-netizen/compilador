<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/itemShopEntryRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="#15FFFFFF"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Preview / Ícone -->
    <TextView
        android:id="@+id/tvShopItemIcon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="#25000000"
        android:gravity="center"
        android:text="🃏"
        android:textSize="22sp" />

    <!-- Nome, Coleção e Descrição -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvShopItemCollection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="COLEÇÃO"
            android:textColor="@color/gold"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/tvShopItemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="sans-serif-bold"
            android:text="Nome do Item"
            android:textColor="@color/hud_text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvShopItemDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="Descrição do cosmético"
            android:textColor="@color/hud_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Botão Visualizar -->
    <Button
        android:id="@+id/btnShopItemPreview"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="6dp"
        android:background="#25FFFFFF"
        android:fontFamily="sans-serif-bold"
        android:padding="0dp"
        android:text="👁️"
        android:textSize="14sp" />

    <!-- Botão de Ação: Equipar / Comprar / Equipado -->
    <Button
        android:id="@+id/btnShopItemAction"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/button_gold"
        android:fontFamily="sans-serif-medium"
        android:minWidth="80dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/shop_item_equip"
        android:textAllCaps="false"
        android:textColor="@color/black"
        android:textSize="11sp" />

</LinearLayout>
