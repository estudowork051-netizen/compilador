<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header: Título e Saldo de Moedas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:text="@string/shop_title"
            android:textColor="@color/gold"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#20FBBF24"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_coin" />

            <TextView
                android:id="@+id/tvShopCoinsBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="0 Moedas"
                android:textColor="@color/gold"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Botão de Vídeo Recompensado -->
    <Button
        android:id="@+id/btnWatchRewardedAd"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/button_gold"
        android:drawableStart="@drawable/ic_video"
        android:drawablePadding="8dp"
        android:fontFamily="sans-serif-bold"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/btn_watch_ad"
        android:textAllCaps="false"
        android:textColor="@color/black"
        android:textSize="13sp" />

    <!-- Painel de Prévia Ampliada Premium (Galeria) -->
    <LinearLayout
        android:id="@+id/layoutShopPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#25000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <com.paciencia.solitaire.ui.SkinPreviewView
            android:id="@+id/shopSkinPreviewView"
            android:layout_width="60dp"
            android:layout_height="86dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPreviewCollection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#30FBBF24"
                android:fontFamily="sans-serif-black"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="COLEÇÃO: TRADIÇÃO"
                android:textColor="@color/gold"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvPreviewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-bold"
                android:text="Skin Clássica"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvPreviewDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Aparência clássica e atemporal de baralho"
                android:textColor="@color/hud_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Abas: Skins de Cartas e Avatares -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="10dp"
        android:background="#15FFFFFF"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/tabSkins"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/button_primary"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/shop_tab_skins"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tabAvatars"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/shop_tab_avatars"
            android:textColor="@color/hud_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Lista de Itens Rolável -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="8dp"
        android:fadeScrollbars="false">

        <LinearLayout
            android:id="@+id/layoutShopItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Botão Fechar -->
    <Button
        android:id="@+id/btnCloseShop"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/button_primary"
        android:fontFamily="sans-serif"
        android:text="@string/btn_close"
        android:textAllCaps="false"
        android:textColor="@color/hud_text_primary"
        android:textSize="14sp" />

</LinearLayout>
