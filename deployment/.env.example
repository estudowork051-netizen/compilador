# Arquivo de configuração de variáveis de ambiente para o RemoteDesk na Nuvem
# Copie este arquivo para .env no servidor de produção (VPS): cp .env.example .env

# Domínio totalmente qualificado (FQDN) apontado para o IP público do VPS (ex: remotedesk.meudominio.com)
DOMAIN_NAME=remotedesk.meudominio.com

# Endereço IP público estático do VPS (usado pelos clientes para resolução de STUN/TURN)
PUBLIC_IP_OR_DOMAIN=203.0.113.10

# E-mail para emissão automática de certificado SSL/TLS gratuito Let's Encrypt via Caddy
ACME_EMAIL=admin@meudominio.com

# Segredo criptográfico de alta entropia para credenciais efêmeras do servidor TURN (HMAC-SHA1)
# Gere um segredo seguro com: openssl rand -hex 32
TURN_SECRET=d8f7e2a4b1c90537482f61e938c4d7b2a1c09485726152438495061728394051

# Porta interna do servidor de sinalização (padrão: 5000)
SIGNALING_PORT=5000
